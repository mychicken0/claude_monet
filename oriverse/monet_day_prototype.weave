material FlowerCardPink { base = "FlowerCardPinkTex" }
material FlowerCardRed { base = "FlowerCardRedTex" }
#meshpart MonetFlowerCard
param s = 70;
param mat = "FlowerCardPink";
let a = rotate_x(plane(width: s, height: s, material: mat), -90);
out.geo = merge(translate(a, (0, 0, s * 0.5 - 6)), translate(rotate_z(a, 90), (0, 0, s * 0.5 - 6)));
#end
#mesh FlowerPinkCard
out.geo = part(MonetFlowerCard, mat: "FlowerCardPink");
#end
#mesh FlowerRedCard
out.geo = part(MonetFlowerCard, s: 60, mat: "FlowerCardRed");
#end
#scatter FlowersPink
  model: "mesh.FlowerPinkCard"
  seed: 1
  spacing: 110
  density_pct: 45
  scale_min_pct: 70
  scale_max_pct: 140
  val_jitter_pct: 15
#end
