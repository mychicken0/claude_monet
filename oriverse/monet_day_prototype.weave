material FlowerEye { base = "FlowerEyeTex" shader = "MeadowSway" param0 = 0.87137 param1 = 0.47932 param2 = 0.04231 param7 = 4 }

// Wild bank flowers (lace, chamomile, buttercup): petal colour all the way (param3 = 2, param8 = top 0.1 m)
material PetalLace { base = "PetalWhiteTex" shader = "MeadowSway" param0 = 0.95 param1 = 0.93 param2 = 0.84 param3 = 2 param4 = 0.11193 param5 = 0.19462 param6 = 0.05781 param7 = 4 param8 = 0.1 }
material PetalCream { base = "PetalWhiteTex" shader = "MeadowSway" param0 = 0.95 param1 = 0.84 param2 = 0.58 param3 = 2 param4 = 0.11193 param5 = 0.19462 param6 = 0.05781 param7 = 4 param8 = 0.1 }
material PetalButter { base = "FlowerEyeTex" shader = "MeadowSway" param0 = 0.92 param1 = 0.66 param2 = 0.06 param3 = 2 param4 = 0.11193 param5 = 0.19462 param6 = 0.05781 param7 = 4 param8 = 0.1 }
material FlowerEyeGold { base = "FlowerEyeTex" shader = "MeadowSway" param0 = 0.87 param1 = 0.50 param2 = 0.04 param3 = 2 param4 = 0.11193 param5 = 0.19462 param6 = 0.05781 param7 = 4 param8 = 0.1 }

// One painted blade: a single tapering ribbon (colour and motion come from PaintedGrass).
#meshpart PaintBlade
param h = 70;
param lean = 14;
param w = 5;
param mat = "PaintGrass";
out.geo = ribbon_path(points: [(0, 0, -3, w), (lean * 0.12, 0, h * 0.38, w * 0.9), (lean * 0.45, 0, h * 0.74, w * 0.6), (lean, 0, h, 0.4)], normal: (0, 1, 0), two_sided: "yes", material: mat);
#end

