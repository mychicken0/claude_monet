#project "Ori.project.@ghohoh404040.claude_monet"
#artstyle "impressionist plein-air oil painting, Claude Monet palette, broken colour dabs, cream and ochre sunlight, lavender and blue-violet shadows, soft low-poly faceted forms"
#set RenderSampling "native_smaa"

#rules
Monet medieval RPG art direction: stylized low-poly geometry + painterly base materials + warm sun / cool sky lighting + light fog. No heavy fullscreen oil-paint filter. Shadows lean lavender/blue, highlights cream/warm yellow.
Reusable kit: Monet* textures are Codex-painted images (tint param); tree species share MonetLeafCard and recolor via leaf_tint; buildings are #meshpart kits with params (MonetHouseKit, MonetTowerKit, MonetBridgeKit, MonetFieldWall, MonetFlowerClump).
#end

// ============================================================
// LIGHTING / ATMOSPHERE (tune in the Adjust panel)
// ============================================================
#adjuster
section "Monet daylight"
knob SetSunTilt = 24
knob SetSunRotation = 215
knob SetSunIntensity = 6
knob SetSunColor = #FFCF96
knob SetSkyLightIntensity = 1.7
knob SetSkyLightColor = #8E98E0
knob SetSkyLightSaturation = 1.6
knob SetShadowOpacity = 0.75
knob SetShadowBlurRadius = 3
knob SetSkyboxCloudCoverage = 0.6
knob SetSkyboxHaze = 2
knob SetSaturation = 1
knob SetContrast = 1.05
knob SetBloomIntensity = 0
knob SetSsrMode = Off
section "Atmosphere"
knob SetDistanceFogEnabled = 1
knob SetFogColor = #D8D0E2
knob SetFogStartDistance = 40
knob SetFogEndDistance = 700
knob SetFogSkyboxAffect = 20
knob SetWindStrength = 0.3
section "River"
knob SetWaterEnabled = 1
knob SetWaterSeaLevelCm = -50
knob SetWaterAmplitudeCm = 3
knob SetWaterShallowColor = #86C0C8
knob SetWaterDeepColor = #3F6FA0
knob SetWaterReflectionStrength = 1
#end

// ============================================================
// PAINTERLY MATERIAL KIT (reusable; colour params are sliders)
// ============================================================
#texture MonetPlasterProc
tile_m = 3.0;
param base = color("#EAD8B4");
param blush = color("#E3B39A");
param shade = color("#AFA6C8");
let big = noise.fbm(uv * 2.0, octaves: 3, seed: 41);
let f = pattern.foliage(uv * 7.0, density: 0.9, size: 0.9, aspect: 0.3, bend: 0.05, angle: 60.0, angle_jitter: 25.0, layers: 2, seed: 42);
let r = rand(f.id);
let c = mix(base, blush, sat(big - 0.4) * 1.2);
out.color = mix(c, mix(mix(shade, blush, sat(r * 2.0)), color("#F2D48A"), sat(r * 2.0 - 1.0)), f.mask * 0.5);
out.normal = normal_from_height(f.height * 0.02 + big * 0.02, strength: 0.4);
out.orm = orm(occlusion: 1.0, roughness: 0.95, metallic: 0.0);
#end

#texture MonetWood
tile_m = 1.5;
param paint = color("#6E8A88");
let g = noise.fbm(uv * vec2(2.0, 16.0), octaves: 3, seed: 61);
let big = noise.fbm(uv * 2.0, octaves: 2, seed: 62);
out.color = mix(paint * 0.7, paint * 1.2, sat(g * 0.7 + big * 0.5));
out.normal = normal_from_height(g * 0.03, strength: 0.5);
out.orm = orm(occlusion: 1.0, roughness: 0.8, metallic: 0.0);
#end

#texture MonetWindowDark
tile_m = 1.0;
let n = noise.fbm(uv * 4.0, octaves: 2, seed: 71);
out.color = mix(color("#2F3A5A"), color("#4E5E86"), n);
out.normal = normal_from_height(n * 0.01, strength: 0.2);
out.orm = orm(occlusion: 1.0, roughness: 0.35, metallic: 0.0);
#end

#texture MonetBark
tile_m = 2.0;
let s = noise.fbm(uv * vec2(3.0, 12.0), octaves: 3, seed: 3);
out.color = ramp(s, [0.0: color("#5B4A62"), 0.5: color("#8A6E58"), 1.0: color("#C4A57A")]);
out.normal = normal_from_height(s * 0.04, strength: 0.5);
out.orm = orm(occlusion: 1.0, roughness: 0.9, metallic: 0.0);
#end

// Leaf-cluster card shared by every Monet tree species (recolour per species with leaf_tint).
#texture MonetLeafCard
mapping = uv;
wrap = clamp;
render_mode = cutout;
size = 512;
let t = image("projimg.monet_leaf_9212e2b2", uv, wrap: "clamp");
out.color = t.rgb;
out.alpha = t.a;
out.normal = normal_from_height(dot(t.rgb, vec3(0.333, 0.333, 0.333)) * 0.03, strength: 0.3);
out.orm = orm(occlusion: 1.0, roughness: 0.85, metallic: 0.0);
#end

// Colour variants: derive, don't duplicate texture code.
// ---- Painted surfaces: Codex-generated Monet oil paintings (oriverse/textures/*.png, imported as project images) ----
// Each is a world-space triplanar #texture; recolour with `tint` or a derived material.
#texture MonetPlaster
mapping = triplanar_world;
tile_m = 3.0;
size = 1024;
param tint = color("#FFFFFF");
param desat = 0.35 range 0.0..1.0;
let c = image("projimg.monet_plaster_06d44a3d", uv, wrap: "repeat").rgb * tint;
let l = dot(c, vec3(0.333, 0.333, 0.333));
out.color = mix(c, vec3(l, l, l), desat);
out.normal = normal_from_height(l * 0.04, strength: 0.5);
out.orm = orm(occlusion: 1.0, roughness: 0.92, metallic: 0.0);
#end
#texture MonetStone
mapping = triplanar_world;
tile_m = 2.5;
size = 512;
param tint = color("#FFFFFF");
param desat = 0.25 range 0.0..1.0;
let c = image("projimg.monet_stone_ea6738d2", uv, wrap: "repeat").rgb * tint;
let l = dot(c, vec3(0.333, 0.333, 0.333));
out.color = mix(c, vec3(l, l, l), desat);
out.normal = normal_from_height(l * 0.04, strength: 0.5);
out.orm = orm(occlusion: 1.0, roughness: 0.92, metallic: 0.0);
#end
#texture MonetRoof
mapping = triplanar_world;
tile_m = 2.0;
size = 512;
param tint = color("#FFFFFF");
param desat = 0.35 range 0.0..1.0;
let c = image("projimg.monet_roof_77a4b275", uv, wrap: "repeat").rgb * tint;
let l = dot(c, vec3(0.333, 0.333, 0.333));
out.color = mix(c, vec3(l, l, l), desat);
out.normal = normal_from_height(l * 0.04, strength: 0.5);
out.orm = orm(occlusion: 1.0, roughness: 0.85, metallic: 0.0);
#end
#texture MonetGrass
mapping = triplanar_world;
tile_m = 6.0;
size = 1024;
param tint = color("#FFFFFF");
param desat = 0.15 range 0.0..1.0;
let c = image("projimg.monet_grass_e3180893", uv, wrap: "repeat").rgb * tint;
let l = dot(c, vec3(0.333, 0.333, 0.333));
out.color = mix(c, vec3(l, l, l), desat);
out.normal = normal_from_height(l * 0.04, strength: 0.5);
out.orm = orm(occlusion: 1.0, roughness: 0.95, metallic: 0.0);
#end
#texture MonetPath
mapping = triplanar_world;
tile_m = 3.0;
size = 1024;
param tint = color("#FFFFFF");
param desat = 0.3 range 0.0..1.0;
let c = image("projimg.monet_path_cdec643e", uv, wrap: "repeat").rgb * tint;
let l = dot(c, vec3(0.333, 0.333, 0.333));
out.color = mix(c, vec3(l, l, l), desat);
out.normal = normal_from_height(l * 0.04, strength: 0.5);
out.orm = orm(occlusion: 1.0, roughness: 0.9, metallic: 0.0);
#end
material MonetPlasterRose { base = "MonetPlaster" tint = "#FBE3DA" }
material MonetPlasterOchre { base = "MonetPlaster" tint = "#F6EAD0" }
material MonetRoofDark { base = "MonetRoof" tint = "#D2B4B4" }
material MonetShutterBlue { base = "MonetWood" tint = "#B4BCD0" }

// Screen pass: Kuwahara oil-paint abstraction (no time input -> no temporal swim),
// lavender-shadow / cream-highlight grade, depth-based atmospheric haze.
// params4[0]: x = paint amount, y = grade, z = haze, w = kernel step (px)
material MonetPaint { shader = "MonetPaintPass" }
#shader MonetPaintPass
let amt = mat.params4[0].x;
let grade = mat.params4[0].y;
let haze = mat.params4[0].z;
let px = vec2<f32>(max(mat.params4[0].w, 1.0)) / vec2<f32>(ctx.resolution);
var m0 = vec3<f32>(0.0); var m1 = vec3<f32>(0.0); var m2 = vec3<f32>(0.0); var m3 = vec3<f32>(0.0);
var q0 = vec3<f32>(0.0); var q1 = vec3<f32>(0.0); var q2 = vec3<f32>(0.0); var q3 = vec3<f32>(0.0);
for (var j: i32 = -3; j <= 3; j = j + 1) {
    for (var i: i32 = -3; i <= 3; i = i + 1) {
        let c = ori_screen_color(ctx.uv + vec2<f32>(f32(i), f32(j)) * px).rgb;
        let c2 = c * c;
        let a0 = select(0.0, 1.0, i <= 0 && j <= 0);
        let a1 = select(0.0, 1.0, i >= 0 && j <= 0);
        let a2 = select(0.0, 1.0, i <= 0 && j >= 0);
        let a3 = select(0.0, 1.0, i >= 0 && j >= 0);
        m0 += c * a0; q0 += c2 * a0;
        m1 += c * a1; q1 += c2 * a1;
        m2 += c * a2; q2 += c2 * a2;
        m3 += c * a3; q3 += c2 * a3;
    }
}
let n = 16.0;
let e0 = m0 / n; let e1 = m1 / n; let e2 = m2 / n; let e3 = m3 / n;
let v0 = abs(q0 / n - e0 * e0); let v1 = abs(q1 / n - e1 * e1); let v2 = abs(q2 / n - e2 * e2); let v3 = abs(q3 / n - e3 * e3);
let s0 = v0.r + v0.g + v0.b; let s1 = v1.r + v1.g + v1.b; let s2 = v2.r + v2.g + v2.b; let s3 = v3.r + v3.g + v3.b;
let w0 = 1.0 / pow(s0 + 0.0004, 2.0); let w1 = 1.0 / pow(s1 + 0.0004, 2.0); let w2 = 1.0 / pow(s2 + 0.0004, 2.0); let w3 = 1.0 / pow(s3 + 0.0004, 2.0);
let paint = (e0 * w0 + e1 * w1 + e2 * w2 + e3 * w3) / (w0 + w1 + w2 + w3);
var col = mix(ctx.color.rgb, paint, amt);
let l = dot(col, vec3<f32>(0.2126, 0.7152, 0.0722));
let sh = 1.0 - smoothstep(0.05, 0.45, l);
let hi = smoothstep(0.55, 0.95, l);
col = mix(col, col * vec3<f32>(0.86, 0.82, 1.14), sh * grade);
col = mix(col, col * vec3<f32>(1.06, 1.0, 0.86), hi * grade);
let d = ori_screen_depth_m(ctx.uv);
let f = smoothstep(25.0, 300.0, d) * (1.0 - step(3000.0, d)) * haze;
col = mix(col, vec3<f32>(0.80, 0.78, 0.90), f * 0.45);
out.color = vec4<f32>(col, 1.0);
#end
material FlowerLeaf { base = "MonetPlasterProc" tint = "#8FA66A" }
material FlowerPink { base = "MonetPlasterProc" tint = "#FF9FC4" }
material FlowerViolet { base = "MonetPlasterProc" tint = "#B79CFF" }
material FlowerRed { base = "MonetPlasterProc" tint = "#FF6A5A" }

// ============================================================
// TREE KIT (reusable species; duplicate + change seed/tint for variants)
// ============================================================
