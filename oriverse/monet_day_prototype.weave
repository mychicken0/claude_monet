#forest MeadowTrees
  species: MonetRoundTree
  seed: 3
  spacing: 1100
  density_pct: 35
  scale_min_pct: 75
  scale_max_pct: 120
#end

// ============================================================
// BUILDING KIT (#meshpart = reusable; #mesh = one tuned variant)
// ============================================================
#meshpart MonetWindow
param ww = 80;
param wh = 110;
param shutter = "MonetWood";
let glass = box_at(size: (ww, 8, wh), bottom_center: (0, 0, 0), material: "MonetWindowDark");
let sl = box_at(size: (ww * 0.5, 6, wh), bottom_center: (0 - ww * 0.78, -3, 0), material: shutter);
let sr = box_at(size: (ww * 0.5, 6, wh), bottom_center: (ww * 0.78, -3, 0), material: shutter);
let sill = box_at(size: (ww + 24, 16, 8), bottom_center: (0, -5, -8), material: "MonetStone");
out.geo = merge(glass, sl, sr, sill);
#end

// Front (windows) faces -Y, door on the -X gable end.
#meshpart MonetHouseKit
param w = 640;
param d = 500;
param floors = 2;
param fh = 290;
param roof_h = 230;
param cols = 3;
param lean = 0.008;
param roof_twist = 1.2;
param seed = 1;
param wall_mat = "MonetPlaster";
param roof_mat = "MonetRoof";
param shutter_mat = "MonetWood";
let hw = floors * fh;
let plinth = box_at(size: (w + 16, d + 16, 70), bottom_center: (0, 0, 0), bevel: 3, material: "MonetStone");
let walls = box_at(size: (w, d, hw), bottom_center: (0, 0, 0), bevel: 3, material: wall_mat);
let quoins = merge(
    box_at(size: (34, 34, hw), bottom_center: (0 - w * 0.5, 0 - d * 0.5, 0), material: "MonetStone"),
    box_at(size: (34, 34, hw), bottom_center: (w * 0.5, 0 - d * 0.5, 0), material: "MonetStone"),
    box_at(size: (34, 34, hw), bottom_center: (0 - w * 0.5, d * 0.5, 0), material: "MonetStone"),
    box_at(size: (34, 34, hw), bottom_center: (w * 0.5, d * 0.5, 0), material: "MonetStone")
);
let sp = w / cols;
let win = part(MonetWindow, shutter: shutter_mat);
let front = translate(grid_array(win, count: (cols, 1, floors), offset: (sp, 0, fh)), (0 - (cols - 1) * sp * 0.5, 0 - d * 0.5, fh * 0.38));
let back = rotate_z(front, 180, pivot: (0, 0, 0));
let door = merge(
    box_at(size: (14, 115, 215), bottom_center: (0 - w * 0.5 - 3, 0, 0), material: shutter_mat),
    box_at(size: (22, 150, 22), bottom_center: (0 - w * 0.5 - 4, 0, 215), material: "MonetStone")
);
let gable = hull(box_at(size: (w, d, 2), bottom_center: (0, 0, hw)), box_at(size: (w, 2, 2), bottom_center: (0, 0, hw + roof_h - 8)), material: wall_mat);
let roof = gable_roof(size: (w, d, 20), bottom_center: (0, 0, hw), roof_height: roof_h, overhang: 35, ridge_axis: "x", material: roof_mat);
let roof2 = rotate_z(jitter(roof, amount: 3, seed: seed), roof_twist);
let chimney = box_at(size: (60, 60, roof_h + 120), bottom_center: (w * 0.28, d * 0.18, hw), bevel: 2, material: "MonetStone");
out.geo = shear(merge(plinth, walls, quoins, front, back, door, gable, roof2, chimney), x_per_z: lean);
#end

#meshpart MonetTowerKit
param r = 260;
param h = 1200;
param roof_h = 520;
param sides = 10;
param roof_mat = "MonetRoof";
let body = cylinder_at(radius: r, height: h, segments: sides, bottom_center: (0, 0, 0), material: "MonetStone");
let cornice = cylinder_at(radius: r + 25, height: 45, segments: sides, bottom_center: (0, 0, h - 45), material: "MonetStone");
let roof = cylinder_at(r_bot: r + 50, r_top: 0, height: roof_h, segments: sides, bottom_center: (0, 0, h), material: roof_mat);
let slit = box_at(size: (24, 24, 110), bottom_center: (0, 0, 0), material: "MonetWindowDark");
let slits = merge(
    radial_array(slit, count: 4, center: (0, 0, h * 0.62), radius: r - 6, axis: (0, 0, 1), rotate: "yes"),
    radial_array(slit, count: 3, center: (0, 0, h * 0.3), radius: r - 6, axis: (0, 0, 1), rotate: "yes")
);
out.geo = shear(merge(body, cornice, roof, slits), x_per_z: 0.006);
#end

// Hump bridge centred on its origin; local z 0 = bank level, base = riverbed.
#meshpart MonetBridgeKit
param half = 560;
param width = 480;
param rise = 150;
param ramp = 260;
param water_half = 300;
param base = -300;
let top = rise;
let mid_half = half - ramp;
let deck = box_bounds(min: (0 - mid_half, 0 - width * 0.5, top - 50), max: (mid_half, width * 0.5, top), material: "MonetPath");
let rampL = wedge_center(size: (ramp, width, top), center: (0 - half + ramp * 0.5, 0, top * 0.5), rise_toward: "+x", material: "MonetPath");
let rampR = wedge_center(size: (ramp, width, top), center: (half - ramp * 0.5, 0, top * 0.5), rise_toward: "-x", material: "MonetPath");
let par_mid = merge(
    box_bounds(min: (0 - mid_half, width * 0.5 - 40, top), max: (mid_half, width * 0.5, top + 85), material: "MonetStone"),
    box_bounds(min: (0 - mid_half, 0 - width * 0.5, top), max: (mid_half, 0 - width * 0.5 + 40, top + 85), material: "MonetStone")
);
let par_ramp = merge(
    beam_between(start: (0 - half, width * 0.5 - 20, 42), end: (0 - mid_half, width * 0.5 - 20, top + 42), cross_width: 40, cross_height: 85, material: "MonetStone"),
    beam_between(start: (0 - half, 0 - width * 0.5 + 20, 42), end: (0 - mid_half, 0 - width * 0.5 + 20, top + 42), cross_width: 40, cross_height: 85, material: "MonetStone"),
    beam_between(start: (half, width * 0.5 - 20, 42), end: (mid_half, width * 0.5 - 20, top + 42), cross_width: 40, cross_height: 85, material: "MonetStone"),
    beam_between(start: (half, 0 - width * 0.5 + 20, 42), end: (mid_half, 0 - width * 0.5 + 20, top + 42), cross_width: 40, cross_height: 85, material: "MonetStone")
);
let bay = water_half;
let arch = arch_frame(width: bay, height: top - 50 - base, depth: width - 20, thickness: 60, arch_height: 140, bottom_center: (0, 0, base), segments: 8, bottom: "no", material: "MonetStone");
let arches = merge(translate(arch, (0 - bay * 0.5, 0, 0)), translate(arch, (bay * 0.5, 0, 0)));
let abut = merge(
    box_bounds(min: (0 - half, 0 - width * 0.5 + 10, base), max: (0 - water_half, width * 0.5 - 10, 0), material: "MonetStone"),
    box_bounds(min: (water_half, 0 - width * 0.5 + 10, base), max: (half, width * 0.5 - 10, 0), material: "MonetStone")
);
out.geo = merge(deck, rampL, rampR, par_mid, par_ramp, arches, abut);
#end

#meshpart MonetFieldWall
param len = 800;
param h = 100;
param t = 50;
param seed = 3;
let body = tessellate(box_at(size: (len, t, h), bottom_center: (0, 0, 0), material: "MonetStone"), level: 2);
out.geo = noise_displace(body, amount: 6, scale: 90, seed: seed);
#end

#meshpart MonetFlowerClump
param bloom = "FlowerPink";
let mound = scale(polyhedron(kind: "ico", radius: 28, material: "FlowerLeaf"), (1.3, 1.1, 0.55));
let blossom = polyhedron(kind: "octa", radius: 7, material: bloom);
let blooms = copy_to_points(blossom, points: [(10, 5, 20), (-12, 8, 18), (4, -12, 19), (-6, -4, 24), (18, -8, 14), (-20, -6, 12), (0, 14, 16)]);
out.geo = flat_shade(merge(mound, blooms));
#end

// ---- tuned variants ----
#mesh HouseA
out.geo = part(MonetHouseKit, w: 700, d: 520, floors: 2, cols: 3, seed: 1);
#end
#mesh HouseB
out.geo = part(MonetHouseKit, w: 520, d: 480, floors: 3, cols: 2, roof_h: 200, lean: -0.01, roof_twist: -1.5, seed: 4, wall_mat: "MonetPlasterRose", roof_mat: "MonetRoofDark", shutter_mat: "MonetShutterBlue");
#end
#mesh HouseC
out.geo = part(MonetHouseKit, w: 860, d: 540, floors: 1, cols: 4, roof_h: 260, lean: 0.012, seed: 7, wall_mat: "MonetPlasterOchre");
#end
#mesh TowerA
out.geo = part(MonetTowerKit);
#end
#mesh BridgeA
sim_box(min: (-560, -240, -300), max: (560, 240, 235));
anchor(mode: "origin");
out.geo = part(MonetBridgeKit);
#end
#mesh FieldWallA
out.geo = part(MonetFieldWall, len: 1400);
#end
#mesh FlowerPinkClump
out.geo = part(MonetFlowerClump, bloom: "FlowerPink");
#end
#mesh FlowerVioletClump
out.geo = part(MonetFlowerClump, bloom: "FlowerViolet");
#end
#mesh FlowerRedClump
out.geo = part(MonetFlowerClump, bloom: "FlowerRed");
#end

#scatter FlowersPink
  model: "mesh.FlowerPinkClump"
  seed: 1
  spacing: 130
  density_pct: 40
  scale_min_pct: 70
  scale_max_pct: 140
  val_jitter_pct: 20
  terrain_normal_align_pct: 0
#end
#scatter FlowersViolet
  model: "mesh.FlowerVioletClump"
  seed: 2
  spacing: 150
  density_pct: 35
  scale_min_pct: 70
  scale_max_pct: 130
  val_jitter_pct: 20
  terrain_normal_align_pct: 0
#end
#scatter FlowersRed
  model: "mesh.FlowerRedClump"
  seed: 3
  spacing: 260
  density_pct: 25
  scale_min_pct: 70
  scale_max_pct: 120
  terrain_normal_align_pct: 0
#end

// ============================================================
// PLAYER
// ============================================================
#class player
event OnSpawned {
    SetDefaultPlayerControlsEnabled(true)
    SetCameraToFirstPerson()
    SetScreenShader(Material.MonetPaint)
    SetMaterialParameterNumber(Material.MonetPaint, 0, 1)
    SetMaterialParameterNumber(Material.MonetPaint, 1, 0.6)
    SetMaterialParameterNumber(Material.MonetPaint, 2, 0.6)
    SetMaterialParameterNumber(Material.MonetPaint, 3, 1.6)
    var PaintOn = true
    forever {
        if IsKeyPressedByThisPlayer(Key.P) {
            PaintOn = !PaintOn
            if PaintOn {
                SetMaterialParameterNumber(Material.MonetPaint, 0, 1)
            } else {
                SetMaterialParameterNumber(Material.MonetPaint, 0, 0)
            }
        }
    }
}
#end

