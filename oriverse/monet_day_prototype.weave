// ---- painted sky: a dome painted stroke by stroke (no photo sky, no screen filter).
// The mesh is a 480 m sphere; its vertex hook pushes it out to wrap the camera ~3 km away,
// so it is always behind everything. Unlit, casts no shadow. The engine water mirrors it.
#texture SkyDomeTex
mapping = uv;
render_mode = cutout_twosided;
size = 16;
out.color = color("#A8BCDC");
out.alpha = 1.0;
#end
material SkyDome { base = "SkyDomeTex" shader = "PaintedSky" lighting = "unlit" }
#shader PaintedSky
@module {
fn strokeProfile(x: f32) -> f32 {
    // loaded round head at x = -1, dry tapering tail toward x = +1
    return pow(max(1.0 - x * x, 0.0), 0.35) * (1.0 - 0.45 * smoothstep(-0.1, 1.0, x));
}
fn skyBase(d: vec3<f32>, sun: vec3<f32>, t: f32) -> vec3<f32> {
    // smooth underpainting: warm cream horizon, lilac-blue middle, cerulean overhead,
    // cumulus banks (cream where the sun lights them, lilac-grey beneath), warm glow toward the sun
    let e = clamp(d.y, -0.3, 1.0);
    let a = atan2(d.z, d.x);
    var c = mix(vec3<f32>(0.74, 0.83, 0.94), vec3<f32>(0.46, 0.64, 0.93), smoothstep(0.0, 0.15, e));
    c = mix(c, vec3<f32>(0.24, 0.44, 0.86), smoothstep(0.15, 0.8, e));
    let p = (1.0 - e) * 2.4;
    let cl = ori_fbm2(cos(a + t * 0.003) * p * 1.7 + 3.0, sin(a + t * 0.003) * p * 1.7 - 5.0, 4, 111u);
    let band = smoothstep(0.02, 0.1, e) * (1.0 - smoothstep(0.5, 0.85, e));
    let cloud = smoothstep(0.53, 0.6, cl) * band;
    let core = smoothstep(0.56, 0.72, cl);
    let lit = 0.45 + 0.55 * max(dot(normalize(vec3<f32>(cos(a), 0.4, sin(a))), sun), 0.0);
    let cloudCol = mix(vec3<f32>(0.70, 0.72, 0.86), vec3<f32>(1.0, 0.98, 0.94), clamp(core * 0.6 + lit * 0.6, 0.0, 1.0));
    c = mix(c, cloudCol, cloud);
    let g = pow(max(dot(d, sun), 0.0), 10.0);
    return mix(c, vec3<f32>(1.0, 0.93, 0.76), g * 0.45);
}
fn skyPaint(d: vec3<f32>, sun: vec3<f32>, t: f32) -> vec3<f32> {
    // overlapping horizontal brush strokes (~1 deg tall, ~4-7 deg long) laid over the underpainting;
    // each stroke carries the colour under its centre, nudged cerulean / lilac / cream
    let el = clamp(d.y, -0.3, 1.0);
    let az = atan2(d.z, d.x);
    let ev = el / 0.017;
    var best = -1.0;
    var bdir = d;
    var bmul = vec3<f32>(1.0);
    for (var j: i32 = -1; j <= 1; j = j + 1) {
        let rj = floor(ev) + f32(j);
        let ec = clamp((rj + 0.5) * 0.017, -0.3, 0.999);
        let alen = 0.075 / max(sqrt(max(1.0 - ec * ec, 0.0)), 0.25);
        let rs = ori_hash2(rj, 1.0, 101u);
        let au = az / alen + rs;
        for (var i: i32 = -1; i <= 1; i = i + 1) {
            let ci = floor(au) + f32(i);
            let h1 = ori_hash2(ci, rj, 103u);
            let h2 = ori_hash2(rj, ci, 107u);
            let h3 = ori_hash2(ci + 3.1, rj - 1.7, 109u);
            let cu = ci + 0.5 + (h1 - 0.5) * 0.5;
            let cv = rj + 0.5 + (h2 - 0.5) * 0.5;
            let x = (au - cu) / (0.8 + h3 * 0.5);
            let dv = (ev - cv) / (0.38 + h1 * 0.22);
            let rag = ori_hash2(floor(x * 5.0), ci * 13.0 + rj, 113u);
            let inside = abs(x) < 1.0 && abs(dv) < strokeProfile(x) * (1.0 - 0.35 * rag * step(0.35, x));
            let pri = ori_hash2(ci, rj, 117u);
            let take = inside && pri > best;
            let ac = (cu - rs) * alen;
            let dc = vec3<f32>(sqrt(max(1.0 - ec * ec, 0.0)) * cos(ac), ec, sqrt(max(1.0 - ec * ec, 0.0)) * sin(ac));
            let tint = select(select(vec3<f32>(1.05, 1.02, 0.93), vec3<f32>(0.93, 0.99, 1.07), h3 < 0.6), vec3<f32>(1.04, 0.95, 1.07), h3 < 0.27);
            let bristle = 0.95 + 0.1 * ori_hash2(floor(dv * 3.0 + 5.0), ci + rj * 31.0, 119u);
            let edge = 1.0 - 0.05 * smoothstep(0.6, 1.0, abs(dv));
            best = select(best, pri, take);
            bdir = select(bdir, dc, vec3<bool>(take));
            bmul = select(bmul, tint * bristle * edge, vec3<bool>(take));
        }
    }
    return skyBase(bdir, sun, t) * bmul;
}
}
@vertex {
    ctx.world_pos = u_camera.camera_position + normalize(ctx.world_pos) * 2980.0;
}
let d = normalize(ctx.world_pos - u_camera.camera_position);
out.base_color = vec4<f32>(skyPaint(d, normalize(u_camera.sun_direction.xyz), u_camera.time_seconds), 1.0);
#end
#mesh SkyDomeMesh
out.geo = sphere(radius: 24000, segments: 48, material: "SkyDome");
#end
display SkyDomeShell { model = "mesh.SkyDomeMesh" position = (0, 0, -24000) cast_shadow = false }

