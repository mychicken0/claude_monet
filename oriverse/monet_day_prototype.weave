// ============================================================
// GPU MONET: brush-dab surface shader
// params: 0 = metres per texture repeat, 1 = dab size (m) near the camera,
//         2 = dab strength (0 = plain texture, 1 = full dabs), 3 = stroke angle (rad),
//         4..6 = RGB tint.  World-space, so strokes never swim with the camera.
// ============================================================
material MonetPlaster { base = "MonetPlasterTex" }
material MonetPlasterRose { base = "MonetPlasterTex" tint = "#FFE6E0" }
material MonetPlasterOchre { base = "MonetPlasterTex" tint = "#FFF2D6" }
material MonetStone { base = "MonetStoneTex" }
material MonetRoof { base = "MonetRoofTex" }
material MonetRoofDark { base = "MonetRoofTex" tint = "#D9C7D1" }
material MonetPath { base = "MonetPathTex" }
material MonetBarkMat { base = "MonetBark" }
material MonetShutterBlue { base = "MonetWood" tint = "#B4BCD0" }
material MonetShutterGreen { base = "MonetWood" tint = "#9FB89A" }
material MonetTimber { base = "MonetWood" tint = "#6A5566" }
material FlowerLeaf { base = "MonetPlasterProc" tint = "#8FA66A" }
material FlowerPink { base = "MonetPlasterProc" tint = "#FF9FC4" }
material FlowerRed { base = "MonetPlasterProc" tint = "#FF6A5A" }


// Terrain: same brush, grass on the flats, painted earth on slopes.

// PS1 look as a fullscreen pass: big low-res pixels (param 0 = vertical
// pixel count, e.g. 240), 15-bit-style colour (param 1 = levels per channel,
// 32) with a 4x4 Bayer dither (param 2 = dither strength), param 3 = on/off.
material Ps1Screen { shader = "Ps1ScreenPass" }
#shader Ps1ScreenPass
let res = vec2<f32>(ctx.resolution);
let lines = max(mat.params4[0].x, 60.0);
let levels = max(mat.params4[0].y, 2.0);
let dith = mat.params4[0].z;
let on = mat.params4[0].w;
let px = res.y / lines;
let cell = floor(ctx.uv * res / px);
let uvq = (cell + vec2<f32>(0.5)) * px / res;
var c = ori_screen_color(uvq).rgb;
let ix = u32(cell.x) % 4u;
let iy = u32(cell.y) % 4u;
let m2a = 2u * ((ix & 1u) ^ (iy & 1u)) + (iy & 1u);
let m2b = 2u * ((ix >> 1u) ^ (iy >> 1u)) + (iy >> 1u);
let bayer = (f32(4u * m2a + m2b) + 0.5) / 16.0 - 0.5;
let q = levels - 1.0;
c = floor(c * q + 0.5 + bayer * dith) / q;
out.color = vec4<f32>(mix(ctx.color.rgb, clamp(c, vec3<f32>(0.0), vec3<f32>(1.0)), step(0.5, on)), 1.0);
#end

// ============================================================
// OIL-PAINT MATERIAL SHADERS (11-11 Memories Retold style, per surface).
// Every surface is rebuilt from overlapping elongated brush strokes laid on
// the world-space plane: each stroke takes ONE flat colour (sampled at its
// centre), gets its own value / warm-cool shift, bristle streaks, and a
// rounded impasto profile that tilts the normal so strokes catch the sun.
// Stroke size grows with distance so far surfaces stay painterly, not noisy.
// ============================================================

// Ground: the same stroke painter on the horizontal plane, meadow hues jittered
// per stroke (yellow-green / sap / blue-green / ochre), path colour on slopes.

// ============================================================
// TREE KIT: low-poly painted foliage masses (a few hundred tris per tree).
// The GPU brush paints each blob warm on the sun side, violet in shade.
// ============================================================

// Round broadleaf tree (~8 m at s = 1). Trunk sinks 80 cm so it sits on sloped ground.

// Italian cypress: stacked elongated blobs tapering upward (~11 m at s = 1).



// ============================================================
// BUILDING KIT (#meshpart = reusable; #mesh = one tuned variant)
// ============================================================
// Window facing -Y: stone surround + lintel + sill, mullions, louvred shutters,
// optional flower box.
#meshpart MonetWindow
param ww = 80;
param wh = 110;
param shutter = "MonetWood";
param frame = "MonetStone";
param flowers = 0;
param bloom = "FlowerPink";
let glass = box_at(size: (ww, 8, wh), bottom_center: (0, 0, 0), material: "MonetWindowDark");
let mull = merge(
    box_at(size: (6, 6, wh), bottom_center: (0, -6, 0), material: shutter),
    box_at(size: (ww, 6, 6), bottom_center: (0, -6, wh * 0.58), material: shutter)
);
let fr = merge(
    box_at(size: (14, 14, wh + 10), bottom_center: (0 - ww * 0.5 - 7, -4, -5), material: frame),
    box_at(size: (14, 14, wh + 10), bottom_center: (ww * 0.5 + 7, -4, -5), material: frame),
    box_at(size: (ww + 44, 18, 20), bottom_center: (0, -6, wh + 2), bevel: 2, material: frame),
    box_at(size: (ww + 34, 22, 9), bottom_center: (0, -9, -12), bevel: 2, material: frame)
);
let panel = box_at(size: (ww * 0.5, 5, wh), bottom_center: (0, -3, 0), material: shutter);
let slat = box_at(size: (ww * 0.5 - 8, 3, 4), bottom_center: (0, -7, 10), material: shutter);
let shutter1 = merge(panel, array(slat, count: 6, offset: (0, 0, wh / 6.5)));
let shutters = merge(translate(shutter1, (0 - ww * 0.75 - 14, 0, 0)), translate(shutter1, (ww * 0.75 + 14, 0, 0)));
var g = merge(glass, mull, fr, shutters);
if flowers > 0 {
    let fbox = box_at(size: (ww + 16, 26, 22), bottom_center: (0, -24, -34), material: shutter);
    let leaf = flat_shade(scale(polyhedron(kind: "ico", radius: 14, material: "FlowerLeaf"), (1.5, 1.0, 0.8)));
    let bl = polyhedron(kind: "octa", radius: 6, material: bloom);
    let leaves = copy_to_points(leaf, points: [(0 - ww * 0.35, -26, -12), (0, -28, -10), (ww * 0.35, -26, -12)]);
    let blooms = copy_to_points(bl, points: [(0 - ww * 0.42, -32, -2), (0 - ww * 0.2, -36, 0), (0, -32, 2), (ww * 0.2, -35, 0), (ww * 0.42, -31, -3), (0 - ww * 0.1, -24, 4), (ww * 0.3, -22, 3)]);
    g = merge(g, fbox, leaves, blooms);
}
out.geo = g;
#end

// Plank door facing -Y with stone surround, lintel and a step.
#meshpart MonetDoor
param dw = 110;
param dh = 215;
param wood = "MonetWood";
let leaf = box_at(size: (dw, 10, dh), bottom_center: (0, -1, 0), material: wood);
let battens = array(box_at(size: (5, 4, dh - 12), bottom_center: (0 - dw * 0.5 + dw * 0.2, -7, 6), material: wood), count: 4, offset: (dw * 0.2, 0, 0));
let surround = merge(
    box_at(size: (20, 16, dh + 10), bottom_center: (0 - dw * 0.5 - 10, -5, 0), material: "MonetStone"),
    box_at(size: (20, 16, dh + 10), bottom_center: (dw * 0.5 + 10, -5, 0), material: "MonetStone"),
    box_at(size: (dw + 60, 20, 26), bottom_center: (0, -6, dh + 4), bevel: 3, material: "MonetStone")
);
let step = box_at(size: (dw + 70, 55, 16), bottom_center: (0, -30, 0), bevel: 2, material: "MonetStone");
out.geo = merge(leaf, battens, surround, step);
#end

// House: windows/front door face -Y. Stone plinth, quoins, string courses,
// optional half-timbering, flower boxes, dormer, capped chimney, ridge tiles.
#meshpart MonetHouseKit
param w = 640;
param d = 500;
param floors = 2;
param fh = 290;
param roof_h = 230;
param cols = 3;
param lean = 0.008;
param roof_twist = 1.2;
param seed = 1;
param wall_mat = "MonetPlaster";
param roof_mat = "MonetRoof";
param shutter_mat = "MonetWood";
param timber = 0;
param dormer = 1;
param flowers = 1;
param bloom = "FlowerPink";
let hw = floors * fh;
let sp = w / cols;
let mid = floor(cols / 2);
let plinth = box_at(size: (w + 16, d + 16, 60), bottom_center: (0, 0, -40), bevel: 3, material: "MonetStone");
let walls = box_at(size: (w, d, hw), bottom_center: (0, 0, 0), bevel: 3, material: wall_mat);
let qa = box_at(size: (46, 46, 30), bottom_center: (0, 0, 0), material: "MonetStone");
let qb = box_at(size: (34, 34, 30), bottom_center: (0, 0, 0), material: "MonetStone");
let quoin = array_pattern(qa, qb, count: floor(hw / 32), offset: (0, 0, 32));
let quoins = merge(
    translate(quoin, (0 - w * 0.5, 0 - d * 0.5, 0)),
    translate(quoin, (w * 0.5, 0 - d * 0.5, 0)),
    translate(quoin, (0 - w * 0.5, d * 0.5, 0)),
    translate(quoin, (w * 0.5, d * 0.5, 0))
);
var trim = box_at(size: (w + 22, d + 22, 20), bottom_center: (0, 0, hw - 20), bevel: 2, material: "MonetStone");
for f in 1..floors {
    trim = merge(trim, box_at(size: (w + 12, d + 12, 14), bottom_center: (0, 0, f * fh - 7), material: "MonetStone"));
}
var fac = empty();
for f in 0..floors {
    for c in 0..cols {
        let x = (c - (cols - 1) * 0.5) * sp;
        if (f == 0) * (c == mid) > 0 {
            fac = merge(fac, translate(part(MonetDoor, wood: shutter_mat), (x, 0 - d * 0.5, 0)));
        } else {
            let fl = (hash(f * 7 + c, seed: seed) < 0.55) * flowers * (f > 0);
            fac = merge(fac, translate(part(MonetWindow, shutter: shutter_mat, flowers: fl, bloom: bloom), (x, 0 - d * 0.5, f * fh + fh * 0.33)));
        }
    }
}
var tim = empty();
if timber > 0 {
    for f in 1..floors {
        let z0 = f * fh;
        tim = merge(tim, box_at(size: (w, 12, 18), bottom_center: (0, 0 - d * 0.5 - 4, z0 + 6), material: "MonetTimber"));
        tim = merge(tim, box_at(size: (w, 12, 16), bottom_center: (0, 0 - d * 0.5 - 4, z0 + fh - 22), material: "MonetTimber"));
        for k in 0..cols + 1 {
            let xk = (k - cols * 0.5) * sp;
            tim = merge(tim, box_at(size: (16, 12, fh - 20), bottom_center: (xk, 0 - d * 0.5 - 4, z0 + 6), material: "MonetTimber"));
            if k < cols {
                tim = merge(tim, beam_between(start: (xk + 10, 0 - d * 0.5 - 6, z0 + 24), end: (xk + sp * 0.22, 0 - d * 0.5 - 6, z0 + fh * 0.3), cross_width: 11, cross_height: 11, material: "MonetTimber"));
            }
        }
    }
}
let front = merge(fac, tim);
let back = rotate_z(front, 180, pivot: (0, 0, 0));
let side_win = translate(rotate_z(part(MonetWindow, shutter: shutter_mat), -90, pivot: (0, 0, 0)), (0 - w * 0.5, 0, fh + fh * 0.33));
let gable = hull(box_at(size: (w, d, 2), bottom_center: (0, 0, hw)), box_at(size: (w, 2, 2), bottom_center: (0, 0, hw + roof_h - 8)), material: wall_mat);
let roof = gable_roof(size: (w, d, 20), bottom_center: (0, 0, hw), roof_height: roof_h, overhang: 35, ridge_axis: "x", material: roof_mat);
let ridge = box_at(size: (w + 70, 30, 24), bottom_center: (0, 0, hw + roof_h + 4), bevel: 4, material: "MonetRoofDark");
var top = merge(jitter(roof, amount: 3, seed: seed), ridge);
if dormer > 0 {
    let dx = (hash(seed, seed: 5) - 0.5) * w * 0.4;
    let dy = 0 - d * 0.3;
    let dz = hw + roof_h * 0.08;
    let dbody = box_at(size: (130, 120, 130), bottom_center: (dx, dy + 40, dz), material: wall_mat);
    let droof = gable_roof(size: (130, 140, 12), bottom_center: (dx, dy + 30, dz + 130), roof_height: 70, overhang: 16, ridge_axis: "y", material: roof_mat);
    let dwin = translate(part(MonetWindow, ww: 56, wh: 72, shutter: shutter_mat), (dx, dy - 20, dz + 28));
    top = merge(top, dbody, droof, dwin);
}
let top2 = rotate_z(top, roof_twist);
let cx = w * 0.3;
let chimney = merge(
    box_at(size: (64, 64, roof_h + 140), bottom_center: (cx, d * 0.18, hw), bevel: 2, material: "MonetStone"),
    box_at(size: (84, 84, 16), bottom_center: (cx, d * 0.18, hw + roof_h + 140), bevel: 2, material: "MonetStone"),
    cylinder_at(radius: 11, height: 34, segments: 6, bottom_center: (cx - 14, d * 0.18, hw + roof_h + 156), material: "MonetRoofDark"),
    cylinder_at(radius: 11, height: 26, segments: 6, bottom_center: (cx + 16, d * 0.18 + 6, hw + roof_h + 156), material: "MonetRoofDark")
);
out.geo = shear(merge(plinth, walls, quoins, trim, front, back, side_win, gable, top2, chimney), x_per_z: lean);
#end

#meshpart MonetTowerKit
param r = 260;
param h = 1200;
param roof_h = 520;
param sides = 10;
param roof_mat = "MonetRoof";
let body = cylinder_at(radius: r, height: h, segments: sides, bottom_center: (0, 0, -60), material: "MonetStone");
let cornice = cylinder_at(radius: r + 25, height: 45, segments: sides, bottom_center: (0, 0, h - 45), material: "MonetStone");
let corbel = cylinder_at(r_bot: r, r_top: r + 25, height: 40, segments: sides, bottom_center: (0, 0, h - 85), material: "MonetStone");
let roof = cylinder_at(r_bot: r + 50, r_top: 0, height: roof_h, segments: sides, bottom_center: (0, 0, h), material: roof_mat);
let finial = cylinder_at(radius: 6, height: 90, segments: 5, bottom_center: (0, 0, h + roof_h - 10), material: "MonetTimber");
let slit = box_at(size: (24, 24, 110), bottom_center: (0, 0, 0), material: "MonetWindowDark");
let slits = merge(
    radial_array(slit, count: 4, center: (0, 0, h * 0.62), radius: r - 6, axis: (0, 0, 1), rotate: "yes"),
    radial_array(slit, count: 3, center: (0, 0, h * 0.3), radius: r - 6, axis: (0, 0, 1), rotate: "yes")
);
out.geo = shear(merge(body, corbel, cornice, roof, finial, slits), x_per_z: 0.006);
#end

// Church: nave + apse + bell tower with spire (distant town landmark).
#meshpart MonetChurchKit
param len = 1600;
param wid = 700;
param nh = 900;
let nave = box_at(size: (len, wid, nh), bottom_center: (0, 0, -80), material: "MonetPlasterOchre");
let buttress = box_at(size: (60, 90, nh - 150), bottom_center: (0, 0, -80), material: "MonetStone");
let buttresses = merge(
    translate(array(buttress, count: 5, offset: (len / 5, 0, 0)), (0 - len * 0.4, 0 - wid * 0.5 - 40, 0)),
    translate(array(buttress, count: 5, offset: (len / 5, 0, 0)), (0 - len * 0.4, wid * 0.5 + 40, 0))
);
let tall_win = box_at(size: (70, 8, 280), bottom_center: (0, 0, 0), material: "MonetWindowDark");
let wins = translate(array(tall_win, count: 4, offset: (len / 5, 0, 0)), (0 - len * 0.3, 0 - wid * 0.5 - 2, nh * 0.35));
let roof = gable_roof(size: (len, wid, 20), bottom_center: (0, 0, nh - 80), roof_height: 460, overhang: 40, ridge_axis: "x", material: "MonetRoofDark");
let apse = cylinder_at(radius: wid * 0.5, height: nh * 0.8, segments: 10, bottom_center: (len * 0.5, 0, -80), material: "MonetPlasterOchre");
let apse_roof = cylinder_at(r_bot: wid * 0.5 + 30, r_top: 0, height: 320, segments: 10, bottom_center: (len * 0.5, 0, nh * 0.8 - 80), material: "MonetRoofDark");
let tx = 0 - len * 0.5 - 180;
let tower = box_at(size: (440, 440, 2300), bottom_center: (tx, 0, -80), material: "MonetStone");
let belfry = merge(
    box_at(size: (90, 460, 200), bottom_center: (tx, 0, 1900), material: "MonetWindowDark"),
    box_at(size: (460, 90, 200), bottom_center: (tx, 0, 1900), material: "MonetWindowDark")
);
let spire = cylinder_at(r_bot: 270, r_top: 0, height: 1200, segments: 8, bottom_center: (tx, 0, 2220), material: "MonetRoofDark");
let rose = rotate_y(cylinder_at(radius: 110, height: 10, segments: 12, bottom_center: (0, 0, 0), material: "MonetWindowDark"), 90);
let roses = translate(rose, (0 - len * 0.5 - 2, 0, nh * 0.6));
out.geo = merge(nave, buttresses, wins, rotate_z(wins, 180, pivot: (0, 0, 0)), roof, apse, apse_roof, tower, belfry, spire, roses);
#end

// Hump bridge centred on its origin; local z 0 = bank level, base = riverbed.
#meshpart MonetBridgeKit
param half = 560;
param width = 480;
param rise = 150;
param ramp = 260;
param water_half = 300;
param base = -360;
let top = rise;
let mid_half = half - ramp;
let deck = box_bounds(min: (0 - mid_half, 0 - width * 0.5, top - 50), max: (mid_half, width * 0.5, top), material: "MonetPath");
let rampL = wedge_center(size: (ramp, width, top), center: (0 - half + ramp * 0.5, 0, top * 0.5), rise_toward: "+x", material: "MonetPath");
let rampR = wedge_center(size: (ramp, width, top), center: (half - ramp * 0.5, 0, top * 0.5), rise_toward: "-x", material: "MonetPath");
let par_mid = merge(
    box_bounds(min: (0 - mid_half, width * 0.5 - 40, top), max: (mid_half, width * 0.5, top + 85), material: "MonetStone"),
    box_bounds(min: (0 - mid_half, 0 - width * 0.5, top), max: (mid_half, 0 - width * 0.5 + 40, top + 85), material: "MonetStone")
);
let par_ramp = merge(
    beam_between(start: (0 - half, width * 0.5 - 20, 42), end: (0 - mid_half, width * 0.5 - 20, top + 42), cross_width: 40, cross_height: 85, material: "MonetStone"),
    beam_between(start: (0 - half, 0 - width * 0.5 + 20, 42), end: (0 - mid_half, 0 - width * 0.5 + 20, top + 42), cross_width: 40, cross_height: 85, material: "MonetStone"),
    beam_between(start: (half, width * 0.5 - 20, 42), end: (mid_half, width * 0.5 - 20, top + 42), cross_width: 40, cross_height: 85, material: "MonetStone"),
    beam_between(start: (half, 0 - width * 0.5 + 20, 42), end: (mid_half, 0 - width * 0.5 + 20, top + 42), cross_width: 40, cross_height: 85, material: "MonetStone")
);
let bay = water_half;
let arch = arch_frame(width: bay, height: top - 50 - base, depth: width - 20, thickness: 60, arch_height: 140, bottom_center: (0, 0, base), segments: 8, bottom: "no", material: "MonetStone");
let arches = merge(translate(arch, (0 - bay * 0.5, 0, 0)), translate(arch, (bay * 0.5, 0, 0)));
let abut = merge(
    box_bounds(min: (0 - half, 0 - width * 0.5 + 10, base), max: (0 - water_half, width * 0.5 - 10, 0), material: "MonetStone"),
    box_bounds(min: (water_half, 0 - width * 0.5 + 10, base), max: (half, width * 0.5 - 10, 0), material: "MonetStone")
);
out.geo = merge(deck, rampL, rampR, par_mid, par_ramp, arches, abut);
#end

#meshpart MonetFieldWall
param len = 800;
param h = 100;
param t = 50;
param seed = 3;
let body = tessellate(box_at(size: (len, t, h + 50), bottom_center: (0, 0, -50), material: "MonetStone"), level: 2);
let cap = tessellate(box_at(size: (len + 10, t + 14, 16), bottom_center: (0, 0, h), material: "MonetStone"), level: 1);
out.geo = noise_displace(merge(body, cap), amount: 7, scale: 70, seed: seed);
#end

// ---- tuned variants ----
#mesh HouseA
sim_box(min: (-380, -300, 0), max: (380, 300, 1000));
anchor(mode: "origin");
out.geo = part(MonetHouseKit, w: 700, d: 520, floors: 2, cols: 3, seed: 1, bloom: "FlowerRed");
#end
#mesh HouseB
sim_box(min: (-290, -270, 0), max: (290, 270, 1200));
anchor(mode: "origin");
out.geo = part(MonetHouseKit, w: 520, d: 480, floors: 3, cols: 3, roof_h: 200, lean: -0.01, roof_twist: -1.5, seed: 4, timber: 1, wall_mat: "MonetPlasterRose", roof_mat: "MonetRoofDark", shutter_mat: "MonetShutterBlue");
#end
#mesh HouseC
sim_box(min: (-460, -300, 0), max: (460, 300, 700));
anchor(mode: "origin");
out.geo = part(MonetHouseKit, w: 860, d: 540, floors: 1, cols: 5, roof_h: 260, lean: 0.012, seed: 7, dormer: 0, wall_mat: "MonetPlasterOchre", shutter_mat: "MonetShutterGreen");
#end
#mesh HouseD
sim_box(min: (-330, -280, 0), max: (330, 280, 1150));
anchor(mode: "origin");
out.geo = part(MonetHouseKit, w: 600, d: 500, floors: 3, cols: 2, roof_h: 240, lean: 0.006, roof_twist: 2.0, seed: 12, timber: 1, wall_mat: "MonetPlaster", shutter_mat: "MonetShutterGreen", bloom: "FlowerRed");
#end
#mesh TowerA
sim_box(min: (-320, -320, 0), max: (320, 320, 1800));
anchor(mode: "origin");
out.geo = part(MonetTowerKit);
#end
#mesh ChurchA
sim_box(min: (-1300, -500, 0), max: (1300, 500, 3500));
anchor(mode: "origin");
out.geo = part(MonetChurchKit);
#end
#mesh BridgeA
sim_box(min: (-560, -240, -360), max: (560, 240, 235));
anchor(mode: "origin");
out.geo = part(MonetBridgeKit);
#end
#mesh FieldWallA
sim_box(min: (-720, -40, 0), max: (720, 40, 130));
anchor(mode: "origin");
out.geo = part(MonetFieldWall, len: 1400);
#end

// Fullscreen oil-paint pass (11-11 Memories Retold look): each pixel is pulled
// from a jittered 'dab' cell along a flow field (ragged brushy silhouettes),
// then a Kuwahara filter flattens colour into paint patches.
// params: 0 paint mix, 1 grade, 2 haze, 3 kuwahara stride px,
//         4 dab cell px, 5 edge wobble px, 6 re-paints per second on plants,
//         7 extra brush wobble px on plants (grass, leaves, flowers only).
material MonetPaint { shader = "MonetPaintPass" }
#shader MonetPaintPass
let amt = mat.params4[0].x;
let grade = mat.params4[0].y;
let haze = mat.params4[0].z;
let stride = max(mat.params4[0].w, 1.0);
let dab = max(mat.params4[1].x, 2.0);
let wob = mat.params4[1].y;
let boil = mat.params4[1].z;
let plantWob = mat.params4[1].w;
let res = vec2<f32>(ctx.resolution);
let pxy = ctx.uv * res;
// plants (green/yellow-green, saturated): upright dab cells, ragged brush edges that
// re-paint a few times a second; walls, road and sky keep the calm static dabs
let c0 = ctx.color.rgb;
let cmx = max(c0.r, max(c0.g, c0.b));
let cmn = min(c0.r, min(c0.g, c0.b));
let plant = smoothstep(0.0, 0.05, c0.g - c0.b) * smoothstep(0.08, 0.24, (cmx - cmn) / (cmx + 0.0001));
let tick = floor(ctx.time_seconds * boil) * step(0.5, plant);
let flow0 = ori_fbm2(pxy.x / 140.0, pxy.y / 140.0, 2, 5u) * 6.2831;
let flow = mix(flow0, 1.5708 + (flow0 - 3.1416) * 0.12, plant);
let dir = vec2<f32>(cos(flow), sin(flow));
let along = dot(pxy, dir);
let across = dot(pxy, vec2<f32>(-dir.y, dir.x));
let cx = floor(along / (dab * 2.2));
let cy = floor(across / dab);
let h1 = ori_hash2(cx + tick * 13.0, cy, 3u);
let h2 = ori_hash2(cx, cy - tick * 7.0, 9u);
let jit = (dir * (h1 - 0.5) * 2.0 + vec2<f32>(-dir.y, dir.x) * (h2 - 0.5)) * (wob + plantWob * plant);
let uv0 = ctx.uv + jit / res;
let px = vec2<f32>(stride) / res;
var m0 = vec3<f32>(0.0); var m1 = vec3<f32>(0.0); var m2 = vec3<f32>(0.0); var m3 = vec3<f32>(0.0);
var q0 = vec3<f32>(0.0); var q1 = vec3<f32>(0.0); var q2 = vec3<f32>(0.0); var q3 = vec3<f32>(0.0);
for (var j: i32 = -3; j <= 3; j = j + 1) {
    for (var i: i32 = -3; i <= 3; i = i + 1) {
        let o = dir * f32(i) * 1.4 + vec2<f32>(-dir.y, dir.x) * f32(j) * 0.7;
        let c = ori_screen_color(uv0 + o * px).rgb;
        let c2 = c * c;
        let a0 = select(0.0, 1.0, i <= 0 && j <= 0);
        let a1 = select(0.0, 1.0, i >= 0 && j <= 0);
        let a2 = select(0.0, 1.0, i <= 0 && j >= 0);
        let a3 = select(0.0, 1.0, i >= 0 && j >= 0);
        m0 += c * a0; q0 += c2 * a0;
        m1 += c * a1; q1 += c2 * a1;
        m2 += c * a2; q2 += c2 * a2;
        m3 += c * a3; q3 += c2 * a3;
    }
}
let n = 16.0;
let e0 = m0 / n; let e1 = m1 / n; let e2 = m2 / n; let e3 = m3 / n;
let v0 = abs(q0 / n - e0 * e0); let v1 = abs(q1 / n - e1 * e1); let v2 = abs(q2 / n - e2 * e2); let v3 = abs(q3 / n - e3 * e3);
let w0 = 1.0 / pow(v0.r + v0.g + v0.b + 0.0004, 2.0);
let w1 = 1.0 / pow(v1.r + v1.g + v1.b + 0.0004, 2.0);
let w2 = 1.0 / pow(v2.r + v2.g + v2.b + 0.0004, 2.0);
let w3 = 1.0 / pow(v3.r + v3.g + v3.b + 0.0004, 2.0);
let paint = (e0 * w0 + e1 * w1 + e2 * w2 + e3 * w3) / (w0 + w1 + w2 + w3);
let streak = 0.98 + 0.04 * ori_hash2(floor(along / 2.0), cy, 21u);
var col = mix(ctx.color.rgb, paint * streak, amt);
let l = dot(col, vec3<f32>(0.2126, 0.7152, 0.0722));
let sh = 1.0 - smoothstep(0.05, 0.45, l);
let hi = smoothstep(0.55, 0.95, l);
col = mix(col, col * vec3<f32>(0.95, 0.96, 1.04) + vec3<f32>(0.025, 0.021, 0.035), sh * grade);
col = mix(col, col * vec3<f32>(1.06, 1.0, 0.86), hi * grade);
let d = ori_screen_depth_m(ctx.uv);
let f = smoothstep(25.0, 300.0, d) * (1.0 - step(2900.0, d)) * haze;
col = mix(col, vec3<f32>(0.86, 0.82, 0.86), f * 0.4);
out.color = vec4<f32>(col, 1.0);
#end

// ============================================================
// PLAYER
// ============================================================
#class player
event OnSpawned {
    SetDefaultPlayerControlsEnabled(true)
    SetCameraToFirstPerson()
    SetMaterialParameterNumber(Material.MonetPaint, 0, 0.65)
    SetMaterialParameterNumber(Material.MonetPaint, 1, 0.35)
    SetMaterialParameterNumber(Material.MonetPaint, 2, 0.7)
    SetMaterialParameterNumber(Material.MonetPaint, 3, 2.6)
    SetMaterialParameterNumber(Material.MonetPaint, 4, 8)
    SetMaterialParameterNumber(Material.MonetPaint, 5, 0.65)
    SetMaterialParameterNumber(Material.MonetPaint, 6, 3)
    SetMaterialParameterNumber(Material.MonetPaint, 7, 3)
    SetMaterialParameterNumber(Material.Ps1Screen, 0, 240)
    SetMaterialParameterNumber(Material.Ps1Screen, 1, 32)
    SetMaterialParameterNumber(Material.Ps1Screen, 2, 1)
    SetMaterialParameterNumber(Material.Ps1Screen, 3, 1)
    SetScreenShader(Material.MonetPaint)
    Print("oil paint screen shader set")
    var Mode = 0
    forever {
        if IsKeyPressedByThisPlayer(Key.P) {
            Mode = Mode + 1
            if Mode > 2 { Mode = 0 }
            if Mode == 0 { SetScreenShader(Material.MonetPaint) }
            if Mode == 1 { SetScreenShader(Material.Ps1Screen) }
            if Mode == 2 { SetScreenShader(None) }
        }
    }
}
#end

