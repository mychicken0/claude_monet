display BdTreeline2 { model = "mesh.TreelineCard" material = "BdTreeline" position = (-12000, -14000, -300) rotation = (0, 0, 313) }
display BdTreeline3 { model = "mesh.TreelineCard" material = "BdTreeline" position = (14000, -16000, -300) rotation = (0, 0, 35) }
display BdTreeline4 { model = "mesh.TreelineCard" material = "BdTreeline" position = (19000, 15000, -300) rotation = (0, 0, 133) }
display BdTreeline5 { model = "mesh.TreelineCard" material = "BdTreeline" position = (-24000, -2000, -300) rotation = (0, 0, 274) }
display BdRidgeN { model = "mesh.RidgeCard" material = "BdRidge" position = (10000, 110000, -2500) rotation = (0, 0, 176) }
display BdRidgeS { model = "mesh.RidgeCard" material = "BdRidge" position = (-5000, -110000, -2500) rotation = (0, 0, 356) }
display BdRidgeE { model = "mesh.RidgeCard" material = "BdRidge" position = (115000, -20000, -2500) rotation = (0, 0, 80) }
display BdRidgeW { model = "mesh.RidgeCard" material = "BdRidge" position = (-105000, 15000, -2500) rotation = (0, 0, 262) }
// ---- wild flowers ----

// ============================================================
// MEADOW, one plant per mesh: every grass blade and every flower is its own
// instance (random scale/yaw/tint), so nothing reads as a repeated clump.
// All plants share the MeadowSway vertex hook (wind + parting around the player).
// ============================================================
// Our own painted grass (the engine's terrain grass takes no custom shader, so it is off).
// Each tuft is a #mesh of ribbon blades scattered on the terrain only (never on walls).
// PaintedGrass moves them like hand-drawn animation: every tuft holds a pose and jumps to
// the next one on its own beat (few frames a second), wind gusts roll across the field,
// blades part around the player, and colour is laid as flat broken-colour dabs.
// params: 0-2 root colour, 3 poses per second, 4-6 tip colour, 7 sway metres,
//         8-10 sunlit dab colour, 11 distance (m) where blades sink into the painted ground.
#texture PlantCardTex
mapping = uv;
render_mode = cutout_twosided;
size = 32;
out.color = color("#7E9A4C");
out.alpha = 1.0;
out.orm = orm(occlusion: 1.0, roughness: 0.85, metallic: 0.0);
#end

material PaintGrass { base = "PlantCardTex" shader = "PaintedGrass" param0 = 0.13 param1 = 0.22 param2 = 0.08 param3 = 4 param4 = 0.56 param5 = 0.64 param6 = 0.24 param7 = 0.12 param8 = 0.86 param9 = 0.74 param10 = 0.34 param11 = 40 }

material PaintGrassDry { base = "PlantCardTex" shader = "PaintedGrass" param0 = 0.22 param1 = 0.24 param2 = 0.10 param3 = 4 param4 = 0.78 param5 = 0.64 param6 = 0.26 param7 = 0.12 param8 = 0.92 param9 = 0.80 param10 = 0.46 param11 = 40 }

#shader PaintedGrass
@vertex {
    let hgt = clamp(ctx.local_pos.y / 0.6, 0.0, 1.0);
    let bend = hgt * hgt;
    let w = ctx.world_pos;
    let fps = max(mat.params4[0].w, 1.0);
    let amp = mat.params4[1].w;
    // each tuft steps on its own beat (scatter tint = per-tuft id); gust fronts roll across
    let mc = ctx.mesh_color.rgb;
    let id = fract(sin(dot(mc, vec3<f32>(12.9898, 78.233, 37.719))) * 43758.5453);
    let wave = ori_fbm2(w.x * 0.12, w.z * 0.12, 2, 7u) * 3.0 - w.x * 0.18;
    let k = floor(u_camera.time_seconds * fps + id + wave);
    let tk = k / fps;
    let g1 = ori_fbm2(w.x * 0.10 + tk * 0.45, w.z * 0.10 - tk * 0.25, 2, 5u) - 0.5;
    let g2 = ori_fbm2(w.z * 0.13 - tk * 0.30, w.x * 0.13 + tk * 0.20, 2, 9u) - 0.5;
    let jig = ori_hash2(k, id * 331.0, 13u) - 0.5;
    let dx = (0.35 + g1 * 1.6 + jig * 0.25) * amp;
    let dz = (g2 * 1.2 + jig * 0.2) * amp;
    ctx.world_pos.x += dx * bend;
    ctx.world_pos.z += dz * bend;
    ctx.world_pos.y -= (abs(dx) + abs(dz)) * 0.35 * bend;
    // part around the player (first-person camera sits above the feet)
    let cam = u_camera.camera_position;
    let d = vec2<f32>(w.x - cam.x, w.z - cam.z);
    let dist = length(d);
    let push = (1.0 - smoothstep(0.3, 1.2, dist)) * hgt;
    let dir = d / max(dist, 0.001);
    ctx.world_pos.x += dir.x * push * 0.45;
    ctx.world_pos.z += dir.y * push * 0.45;
    ctx.world_pos.y -= push * 0.3;
    // far away the painted ground texture takes over: blades sink out of sight
    let keep = 1.0 - smoothstep(mat.params4[2].w * 0.7, mat.params4[2].w, dist);
    ctx.world_pos.y -= ctx.local_pos.y * 1.4 * (1.0 - keep);
}
// flat broken-colour dabs up each blade; a soft, mostly-up normal keeps the shading calm
let p = ctx.local_pos;
let hgt = clamp(p.y / 0.6, 0.0, 1.0);
let lane = floor((p.x * 0.8 + p.z * 1.3) * 22.0);
let seg = floor(p.y * 14.0 + ori_hash2(lane, 1.0, 5u) * 3.0);
let dab = ori_hash2(lane, seg, 41u);
let dab2 = ori_hash2(seg, lane, 43u);
var col = mix(mat.params4[0].xyz, mat.params4[1].xyz, smoothstep(0.05, 0.95, hgt));
col = col * (0.82 + dab * 0.36);
col = mix(col, mat.params4[2].xyz, smoothstep(0.5, 1.0, hgt) * step(0.6, dab2) * 0.55);
col = mix(col, col * vec3<f32>(0.80, 0.92, 1.18), (1.0 - hgt) * 0.45 * (1.0 - dab2));
col = col * ctx.mesh_color.rgb;
out.base_color = vec4<f32>(col, 1.0);
out.world_normal = normalize(vec3<f32>((dab - 0.5) * 0.4, 1.0, (dab2 - 0.5) * 0.4));
out.orm = vec4<f32>(1.0, 0.95, 0.0, 0.0);
#end

#texture FlowerStemTex color=#5E7A44 roughness=0.85

#texture PetalWhiteTex color=#F7F2E6 roughness=0.8

#texture PetalPinkTex color=#F0A7C2 roughness=0.8

#texture PetalLavTex color=#A99BD6 roughness=0.8

#texture FlowerEyeTex color=#F0B83A roughness=0.8

material FlowerStem { base = "FlowerStemTex" shader = "MeadowSway" param0 = 0.11193 param1 = 0.19462 param2 = 0.05781 param7 = 4 }

material PetalWhite { base = "PetalWhiteTex" shader = "MeadowSway" param0 = 0.93011 param1 = 0.88792 param2 = 0.79130 param3 = 1 param4 = 0.11193 param5 = 0.19462 param6 = 0.05781 param8 = 0.55 param7 = 4 }

