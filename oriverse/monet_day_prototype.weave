#texture MonetPlasterTex
mapping = triplanar_world;
tile_m = 3.0;
size = 512;
param tint = color("#FFF6EE");
param desat = 0.5 range 0.0..1.0;
let c = image("projimg.monet_plaster_06d44a3d", uv, wrap: "repeat").rgb * tint;
let l = dot(c, vec3(0.333, 0.333, 0.333));
out.color = mix(c, vec3(l, l, l), desat);
out.normal = normal_from_height(l * 0.04, strength: 0.5);
out.orm = orm(occlusion: 1.0, roughness: 0.92, metallic: 0.0);
#end
