#forest MeadowTrees
  species: MonetRoundTree
  seed: 3
  spacing: 1100
  density_pct: 35
  scale_min_pct: 75
  scale_max_pct: 120
#end
#shader MeadowSway
@vertex {
    let hgt = clamp(ctx.local_pos.y / 0.6, 0.0, 1.0);
    let bend = hgt * hgt;
    let w = ctx.world_pos;
    let fps = max(mat.params4[1].w, 1.0);
    let t = floor(u_camera.time_seconds * fps + ori_hash2(floor(w.x * 2.0), floor(w.z * 2.0), 3u)) / fps;
    let gust = ori_fbm2(w.x * 0.08 + t * 0.35, w.z * 0.08 - t * 0.2, 2, 5u) - 0.5;
    let sway = sin(t * 0.9 + w.x * 0.45 + w.z * 0.3) * 0.045 + gust * 0.09;
    ctx.world_pos.x += sway * bend;
    ctx.world_pos.z += sway * 0.6 * bend;
    let cam = u_camera.camera_position;
    let d = vec2<f32>(w.x - cam.x, w.z - cam.z);
    let dist = length(d);
    let push = (1.0 - smoothstep(0.25, 1.3, dist)) * hgt;
    let dir = d / max(dist, 0.001);
    ctx.world_pos.x += dir.x * push * 0.5;
    ctx.world_pos.z += dir.y * push * 0.5;
    ctx.world_pos.y -= push * 0.28;
}
// Plant-local dabs follow the plant; only a faint repaint changes at each held frame.
let fps = max(mat.params4[1].w, 1.0);
let tick = floor(u_camera.time_seconds * fps);
let p = ctx.local_pos;
let cell = floor(vec2<f32>(p.x * 35.0 + p.z * 19.0, p.y * 24.0));
let dab = ori_hash2(cell.x, cell.y, 41u);
let repaint = ori_hash2(cell.x + tick * 13.0, cell.y, 47u) - 0.5;
let bristle = sin((p.x + p.z) * 420.0 + p.y * 18.0);
let hgt = clamp(p.y / 0.6, 0.0, 1.0);
var pigment = mix(mat.params4[0].xyz, mat.params4[1].xyz, smoothstep(0.15, 0.95, hgt));
if mat.params4[0].w > 0.5 {
    let top = mat.params4[2].x;
    pigment = mix(mat.params4[1].xyz, mat.params4[0].xyz, smoothstep(top - 0.10, top - 0.04, p.y));
    if mat.params4[0].w < 1.5 {
        let eye = (1.0 - smoothstep(0.01, 0.025, length(p.xz - vec2<f32>(0.02, 0.01)))) * step(top - 0.04, p.y);
        pigment = mix(pigment, vec3<f32>(0.87, 0.48, 0.04), eye);
    }
}
pigment *= ctx.mesh_color.rgb;
var paint = pigment * (0.86 + dab * 0.28 + bristle * 0.025 + repaint * 0.025);
paint = mix(paint, paint * vec3<f32>(0.92, 0.94, 1.10), (1.0 - dab) * 0.24);
out.base_color = vec4<f32>(paint, 1.0);
out.orm = vec4<f32>(1.0, 0.96, 0.0, 0.0);
#end


