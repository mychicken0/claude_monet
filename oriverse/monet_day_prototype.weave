// One flower: stem + a ring of petals + eye. Head tilts toward the viewer side.
#meshpart MonetFlower
param h = 55;
param r = 5.5;
param n = 9;
param pw = 0.34;
param petal = "PetalWhite";
param eye_r = 1.8;
let stem = beam_between(start: (0, 0, -4), end: (2, 1, h), cross_width: 0.7, cross_height: 0.7, material: "FlowerStem");
let leaf = scale(polyhedron(kind: "octa", radius: 7, material: "FlowerStem"), (1.0, 0.25, 0.12));
let leaves = merge(translate(rotate_y(leaf, -30), (5, 0, h * 0.35)), translate(rotate_y(leaf, 210), (-4, 0, h * 0.2)));
let pet = translate(scale(polyhedron(kind: "octa", radius: r * 0.55, material: petal), (1.0, pw, 0.12)), (r * 0.5, 0, 0));
let ring = radial_array(pet, count: n, center: (0, 0, 0), radius: 0.1, axis: (0, 0, 1), rotate: "yes");
let eye = scale(polyhedron(kind: "octa", radius: eye_r, material: "FlowerEye"), (1, 1, 0.6));
let head = translate(rotate_y(merge(ring, eye), 35), (2, 1, h));
out.geo = merge(stem, leaves, head);
#end

#mesh FlowerDaisy
out.geo = part(MonetFlower);
#end

#mesh FlowerCosmos
out.geo = part(MonetFlower, h: 65, r: 7, n: 8, pw: 0.6, petal: "PetalPink", eye_r: 1.4);
#end

// Lavender: a stem with buds stacked up the top third.
#meshpart MonetLavender
param h = 60;
let stem = beam_between(start: (0, 0, -4), end: (1, 0, h), cross_width: 0.6, cross_height: 0.6, material: "FlowerStem");
let bud = scale(polyhedron(kind: "octa", radius: 1.6, material: "PetalLav"), (1, 1, 1.4));
let buds = copy_to_points(bud, points: [(1, 0, h), (0.4, 0.9, h - 3), (1.6, -0.8, h - 5), (0.2, -0.9, h - 8), (1.5, 0.9, h - 10), (0.5, 0.6, h - 13), (1.3, -0.7, h - 15), (0.6, 0.2, h - 18)]);
out.geo = merge(stem, buds);
#end

#mesh FlowerLavender
out.geo = part(MonetLavender);
#end

// Wild lace sprig (baby's breath / small yarrow): a low, bent stem that forks, with a few loose
// white specks - tucked in among the grass blades, not standing above them, so the bank reads
// as small white dabs scattered through the green, like the reference painting.
#meshpart MonetUmbel
param h = 38;
param n = 8;
param floret = "PetalLace";
param dr = 1.3;
let s1 = beam_between(start: (0, 0, -4), end: (2, 1, h * 0.55), cross_width: 0.35, cross_height: 0.35, material: "FlowerStem");
let s2 = beam_between(start: (2, 1, h * 0.55), end: (5, 2, h), cross_width: 0.3, cross_height: 0.3, material: "FlowerStem");
let s3 = beam_between(start: (2, 1, h * 0.55), end: (-2, 3, h * 0.82), cross_width: 0.3, cross_height: 0.3, material: "FlowerStem");
let dot = scale(polyhedron(kind: "ico", radius: dr, material: floret), (1.0, 1.0, 0.8));
var g = merge(s1, s2, s3, copy_to_points(dot, points: [(5, 2, h), (6.5, 3, h - 1.5), (3.5, 3, h - 2), (-2, 3, h * 0.82), (-3.2, 4, h * 0.82 - 1.5)]));
if n > 5 {
    g = merge(g, copy_to_points(dot, points: [(7, 0.5, h - 3), (4, 0, h - 4), (-1, 4.5, h * 0.82 - 2.5)]));
}
out.geo = g;
#end

#mesh WildLace
out.geo = part(MonetUmbel);
#end
#mesh WildLace lod: 1
out.geo = part(MonetUmbel, n: 4);
#end

#mesh WildLaceCream
out.geo = part(MonetUmbel, h: 30, floret: "PetalCream", dr: 1.2);
#end
#mesh WildLaceCream lod: 1
out.geo = part(MonetUmbel, h: 30, n: 4, floret: "PetalCream", dr: 1.2);
#end

// Chamomile / buttercup: a small clump of little flower heads on thin stems at different heights.
#meshpart MonetSmallBloom
param h = 30;
param petal = "PetalLace";
param np = 10;
param pr = 1.3;
param pw = 0.36;
param heads = 3;
let pet = translate(scale(polyhedron(kind: "octa", radius: pr, material: petal), (1.0, pw, 0.15)), (pr * 0.95, 0, 0));
let ring = radial_array(pet, count: np, center: (0, 0, 0), radius: 0.1, axis: (0, 0, 1), rotate: "yes");
let eye = scale(polyhedron(kind: "ico", radius: pr * 0.65, material: "FlowerEyeGold"), (1, 1, 0.7));
let head = merge(ring, eye);
let s1 = beam_between(start: (0, 0, -4), end: (1, 0.5, h), cross_width: 0.5, cross_height: 0.5, material: "FlowerStem");
var g = merge(s1, translate(rotate_y(head, 25), (1, 0.5, h)));
if heads > 1 {
    let s2 = beam_between(start: (0, 0, -4), end: (5, 2.5, h * 0.8), cross_width: 0.45, cross_height: 0.45, material: "FlowerStem");
    let s3 = beam_between(start: (0, 0, -4), end: (-3, 4.5, h * 0.66), cross_width: 0.45, cross_height: 0.45, material: "FlowerStem");
    g = merge(g, s2, translate(rotate_y(head, -20), (5, 2.5, h * 0.8)), s3, translate(rotate_x(head, 25), (-3, 4.5, h * 0.66)));
}
out.geo = g;
#end

#mesh WildChamomile
out.geo = part(MonetSmallBloom);
#end
#mesh WildChamomile lod: 1
out.geo = part(MonetSmallBloom, heads: 1);
#end

#mesh WildButtercup
out.geo = part(MonetSmallBloom, h: 24, petal: "PetalButter", np: 5, pr: 1.5, pw: 0.8);
#end
#mesh WildButtercup lod: 1
out.geo = part(MonetSmallBloom, h: 24, petal: "PetalButter", np: 5, pr: 1.5, pw: 0.8, heads: 1);
#end

