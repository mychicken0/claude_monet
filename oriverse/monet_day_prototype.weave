// ---- wild flowers ----

// ============================================================
// MEADOW, one plant per mesh: every grass blade and every flower is its own
// instance (random scale/yaw/tint), so nothing reads as a repeated clump.
// All plants share the MeadowSway vertex hook (wind + parting around the player).
// ============================================================
// Blade colour is computed on the GPU from height + sun: root -> tip gradient,
// sunlit side warm gold, shaded side violet-blue. params: 0-2 root, 4-6 tip, 8-10 cool.

#texture PlantCardTex
mapping = uv;
render_mode = cutout_twosided;
size = 32;
out.color = color("#7E9A4C");
out.alpha = 1.0;
out.orm = orm(occlusion: 1.0, roughness: 0.85, metallic: 0.0);
#end

material GrassBlade { base = "PlantCardTex" shader = "MeadowSway" param0 = 0.10224 param1 = 0.19462 param2 = 0.06480 param4 = 0.57758 param5 = 0.63076 param6 = 0.21586 param7 = 8 }

material GrassBladeTip { base = "PlantCardTex" shader = "MeadowSway" param0 = 0.57758 param1 = 0.63076 param2 = 0.21586 param7 = 8 }

material GrassBladeDry { base = "PlantCardTex" shader = "MeadowSway" param0 = 0.19462 param1 = 0.21586 param2 = 0.08022 param4 = 0.80695 param5 = 0.68669 param6 = 0.27889 param7 = 8 }

material GrassBladeDryTip { base = "PlantCardTex" shader = "MeadowSway" param0 = 0.80695 param1 = 0.68669 param2 = 0.27889 param7 = 8 }

#texture FlowerStemTex color=#5E7A44 roughness=0.85

#texture PetalWhiteTex color=#F7F2E6 roughness=0.8

#texture PetalPinkTex color=#F0A7C2 roughness=0.8

#texture PetalLavTex color=#A99BD6 roughness=0.8

#texture FlowerEyeTex color=#F0B83A roughness=0.8

material FlowerStem { base = "FlowerStemTex" shader = "MeadowSway" param0 = 0.11193 param1 = 0.19462 param2 = 0.05781 param7 = 8 }

material PetalWhite { base = "PetalWhiteTex" shader = "MeadowSway" param0 = 0.93011 param1 = 0.88792 param2 = 0.79130 param3 = 1 param4 = 0.11193 param5 = 0.19462 param6 = 0.05781 param8 = 0.55 param7 = 8 }

material PetalPink { base = "PetalPinkTex" shader = "MeadowSway" param0 = 0.87137 param1 = 0.38643 param2 = 0.53948 param3 = 1 param4 = 0.11193 param5 = 0.19462 param6 = 0.05781 param8 = 0.65 param7 = 8 }

material PetalLav { base = "PetalLavTex" shader = "MeadowSway" param0 = 0.39676 param1 = 0.32778 param2 = 0.67244 param3 = 2 param4 = 0.11193 param5 = 0.19462 param6 = 0.05781 param8 = 0.60 param7 = 8 }

material FlowerEye { base = "FlowerEyeTex" shader = "MeadowSway" param0 = 0.87137 param1 = 0.47932 param2 = 0.04231 param7 = 8 }

// One curved blade (ribbon, tapering to a point).
#meshpart MonetBlade
param h = 70;
param lean = 16;
param w = 5.5;
param mat = "GrassBlade";
param tip = "GrassBladeTip";
let low = ribbon_path(points: [(0, 0, -4, w), (lean * 0.15, 0, h * 0.3, w * 0.92), (lean * 0.36, 0, h * 0.56, w * 0.78)], normal: (0, 1, 0), two_sided: "no", material: mat);
let high = ribbon_path(points: [(lean * 0.36, 0, h * 0.56, w * 0.78), (lean * 0.65, 0, h * 0.8, w * 0.5), (lean, 0, h, 0.3)], normal: (0, 1, 0), two_sided: "no", material: tip);
out.geo = merge(low, high);
#end

#mesh BladeA
out.geo = merge(
    part(MonetBlade, h: 70, lean: 16),
    translate(rotate_z(part(MonetBlade, h: 55, lean: 20), 70), (9, 4, 0)),
    translate(rotate_z(part(MonetBlade, h: 82, lean: 11), 150), (-6, 8, 0)),
    translate(rotate_z(part(MonetBlade, h: 46, lean: 24), 215), (-10, -5, 0)),
    translate(rotate_z(part(MonetBlade, h: 64, lean: 14), 290), (4, -9, 0)),
    translate(rotate_z(part(MonetBlade, h: 38, lean: 18), 110), (14, -3, 0)),
    translate(rotate_z(part(MonetBlade, h: 58, lean: 9), 330), (-3, 13, 0))
);
#end

#mesh BladeB
out.geo = merge(
    part(MonetBlade, h: 48, lean: 22, w: 5.0, mat: "GrassBladeDry", tip: "GrassBladeDryTip"),
    translate(rotate_z(part(MonetBlade, h: 40, lean: 18, w: 4.5, mat: "GrassBladeDry", tip: "GrassBladeDryTip"), 95), (8, 6, 0)),
    translate(rotate_z(part(MonetBlade, h: 56, lean: 12, w: 5.0, mat: "GrassBladeDry", tip: "GrassBladeDryTip"), 200), (-7, 5, 0)),
    translate(rotate_z(part(MonetBlade, h: 34, lean: 20, w: 4.0, mat: "GrassBladeDry", tip: "GrassBladeDryTip"), 280), (2, -9, 0)),
    translate(rotate_z(part(MonetBlade, h: 44, lean: 15, w: 4.5), 20), (-11, -6, 0))
);
#end

#mesh BladeC
out.geo = merge(
    part(MonetBlade, h: 88, lean: 9, w: 4.5),
    translate(rotate_z(part(MonetBlade, h: 96, lean: 14, w: 4.0), 120), (6, 7, 0)),
    translate(rotate_z(part(MonetBlade, h: 74, lean: 18, w: 4.5), 240), (-7, 4, 0)),
    translate(rotate_z(part(MonetBlade, h: 66, lean: 12, w: 4.0, mat: "GrassBladeDry", tip: "GrassBladeDryTip"), 300), (3, -8, 0))
);
#end

// One flower: stem + a ring of petals + eye. Head tilts toward the viewer side.
#meshpart MonetFlower
param h = 55;
param r = 5.5;
param n = 9;
param pw = 0.34;
param petal = "PetalWhite";
param eye_r = 1.8;
let stem = beam_between(start: (0, 0, -4), end: (2, 1, h), cross_width: 0.7, cross_height: 0.7, material: "FlowerStem");
let leaf = scale(polyhedron(kind: "octa", radius: 7, material: "FlowerStem"), (1.0, 0.25, 0.12));
let leaves = merge(translate(rotate_y(leaf, -30), (5, 0, h * 0.35)), translate(rotate_y(leaf, 210), (-4, 0, h * 0.2)));
let pet = translate(scale(polyhedron(kind: "octa", radius: r * 0.55, material: petal), (1.0, pw, 0.12)), (r * 0.5, 0, 0));
let ring = radial_array(pet, count: n, center: (0, 0, 0), radius: 0.1, axis: (0, 0, 1), rotate: "yes");
let eye = scale(polyhedron(kind: "octa", radius: eye_r, material: "FlowerEye"), (1, 1, 0.6));
let head = translate(rotate_y(merge(ring, eye), 35), (2, 1, h));
out.geo = merge(stem, leaves, head);
#end

#mesh FlowerDaisy
out.geo = part(MonetFlower);
#end

#mesh FlowerCosmos
out.geo = part(MonetFlower, h: 65, r: 7, n: 8, pw: 0.6, petal: "PetalPink", eye_r: 1.4);
#end

// Lavender: a stem with buds stacked up the top third.
#meshpart MonetLavender
param h = 60;
let stem = beam_between(start: (0, 0, -4), end: (1, 0, h), cross_width: 0.6, cross_height: 0.6, material: "FlowerStem");
let bud = scale(polyhedron(kind: "octa", radius: 1.6, material: "PetalLav"), (1, 1, 1.4));
let buds = copy_to_points(bud, points: [(1, 0, h), (0.4, 0.9, h - 3), (1.6, -0.8, h - 5), (0.2, -0.9, h - 8), (1.5, 0.9, h - 10), (0.5, 0.6, h - 13), (1.3, -0.7, h - 15), (0.6, 0.2, h - 18)]);
out.geo = merge(stem, buds);
#end

#mesh FlowerLavender
out.geo = part(MonetLavender);
#end

