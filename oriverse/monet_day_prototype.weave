// ============================================================
#texture SkyCloudATex
mapping = uv;
wrap = clamp;
render_mode = cutout_twosided;
size = 512;
let t = image("projimg.cloud_a_99f518cb", uv, wrap: "clamp");
out.color = t.rgb;
out.alpha = t.a;
out.normal = normal_from_height(0.0, strength: 0.1);
out.orm = orm(occlusion: 1.0, roughness: 1.0, metallic: 0.0);
#end
