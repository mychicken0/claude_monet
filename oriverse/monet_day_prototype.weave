#doc_version 3
#project "Ori.project.@ghohoh404040.claude_monet"
#artstyle "impressionist plein-air oil painting, Claude Monet palette, broken colour dabs, cream and ochre sunlight, lavender and blue-violet shadows, soft low-poly faceted forms"
#set RenderSampling "native_smaa"

#rules
Monet medieval RPG art direction: stylized low-poly geometry + painterly base materials + warm sun / cool sky lighting + light fog. No heavy fullscreen oil-paint filter. Shadows lean lavender/blue, highlights cream/warm yellow.
Reusable kit: Monet* textures are Codex-painted images; surfaces are painted on the GPU by the MonetBrushSurface #shader (world-space brush dabs, warm sun / violet shade). Trees are low-poly foliage-mass #meshparts (MonetRoundTreeKit, MonetCypressKit); buildings are #meshpart kits with params (MonetHouseKit, MonetChurchKit, MonetTowerKit, MonetBridgeKit, MonetFieldWall). Ground is the #terrain recipe MonetValley.
#end

// ============================================================
// LIGHTING / ATMOSPHERE (tune in the Adjust panel)
// ============================================================
#adjuster
section "Monet daylight"
knob SetSunTilt = 32
knob SetSunRotation = 215
knob SetSunIntensity = 8
knob SetSunColor = #FFD9A0
knob SetSkyLightIntensity = 1.4
knob SetSkyLightColor = #98ADEB
knob SetSkyLightSaturation = 1.2
knob SetShadowOpacity = 0.6
knob SetShadowBlurRadius = 7
knob SetSkyboxCloudCoverage = 0.25
knob SetSkyboxHaze = 3
knob SetSaturation = 1.35
knob SetContrast = 1.15
knob SetBloomIntensity = 0.3
knob SetSsrMode = Off
section "Atmosphere"
knob SetDistanceFogEnabled = 0
knob SetFogColor = #E4DACC
knob SetFogStartDistance = 30
knob SetFogEndDistance = 900
knob SetFogSkyboxAffect = 20
knob SetWindStrength = 0.15
section "Painterly softness"
knob SetDofEnabled = 1
knob SetDofArtisticEnabled = 1
knob SetDofFocusDistanceM = 10
knob SetDofFocusRangeM = 18
knob SetDofNearTransitionM = 0.5
knob SetDofFarTransitionM = 60
knob SetDofFStop = 2.8
section "Meadow grass"
knob SetGrassRootColor = #3E5A2A
knob SetGrassTipColor = #BCCB6A
knob SetGrassBrightnessVariationPercent = 170
knob SetGrassSizeVariationPercent = 100
knob SetGrassHeightMinCm = 26
knob SetGrassHeightMaxCm = 72
knob SetGrassWavePeriodCm = 700
knob SetGrassWindStrengthCm = 4
knob SetGrassWindSpeedPercent = 45
knob SetGrassSpacingCm = 4
knob SetGrassBladeDensityPercent = 100
knob SetGrassBladeWidthPercent = 160
knob SetGrassBendStrengthPercent = 170
knob SetGrassTerrainActiveDistanceM = 32
knob SetTreeLodSwitchDistanceM = 20
section "River"
knob SetWaterEnabled = 1
knob SetWaterSeaLevelCm = -50
knob SetWaterAmplitudeCm = 3
knob SetWaterShallowColor = #86C0C8
knob SetWaterDeepColor = #3F6FA0
knob SetWaterReflectionStrength = 1
#end

// ============================================================
// TERRAIN: flat play corridor + town pad, rolling meadows, river,
// a ring of downs and a hill for the distant town (all metres).
// ============================================================
#terrain MonetValley
mound_height_m = 0
gully_depth_m = 0
landform_blend = max
hill TownHill = center=(330,60), height=34, front=110, back=120, left=130, right=110, crown=0.35
hill NorthDown = center=(90,270), height=26, front=170, back=170, left=160, right=150
hill WestDown = center=(-260,120), height=20, front=140, back=150, left=120, right=140
hill SouthDown = center=(-60,-250), height=24, front=160, back=160, left=170, right=160
hill EastSouth = center=(260,-230), height=30, front=150, back=140, left=130, right=150
ridge_path = 160, 140, -1400, 1300, -400, 1500, 600, 1400, 1500, 1100
ridge_path = 160, 120, -1500, -1200, -300, -1400, 800, -1350, 1600, -1000
mask Town = center=(68,0), radii=(56,32), fade=14
mask Clear = center=(-25,0), radii=(75,11), fade=12, mask=Town
detail Rolling = height=3.2, size=42, octaves=2, mode=billow, mask=Clear
detail Fine = height=0.6, size=10, mode=billow, mask=Clear
flatten_rect = 68, 0, 46, 26, 0, 14
flatten_rect = -25, 0, 62, 9, 0, 14
carve_path = width=7, depth=3.4, smooth=1, points=[(23,-700),(21,-250),(23,0),(24,250),(20,700)]
#end

#class MonetWorld
event OnSpawned {
    SetCameraFarDistanceM(3000)
    var t = SpawnTerrainRecipe(100, Origin())
    t.SetTerrainMaterial(Material.MonetGrassTex)
    t.SetTerrainLayers(Material.MonetPathTex, None, None)
    t.SetTerrainGrassVisible(false)
}
#end
display World : MonetWorld { visible = false }

// ============================================================
// PAINTED SURFACE TEXTURES (Codex oil paintings, bake sources for the GPU brush)
// ============================================================
#texture MonetPlasterProc
tile_m = 3.0;
param base = color("#EAD8B4");
param blush = color("#E3B39A");
param shade = color("#AFA6C8");
let big = noise.fbm(uv * 2.0, octaves: 3, seed: 41);
let f = pattern.foliage(uv * 7.0, density: 0.9, size: 0.9, aspect: 0.3, bend: 0.05, angle: 60.0, angle_jitter: 25.0, layers: 2, seed: 42);
let r = rand(f.id);
let c = mix(base, blush, sat(big - 0.4) * 1.2);
out.color = mix(c, mix(mix(shade, blush, sat(r * 2.0)), color("#F2D48A"), sat(r * 2.0 - 1.0)), f.mask * 0.5);
out.normal = normal_from_height(f.height * 0.02 + big * 0.02, strength: 0.4);
out.orm = orm(occlusion: 1.0, roughness: 0.95, metallic: 0.0);
#end

#texture MonetWood
tile_m = 1.5;
param paint = color("#6E8A88");
let g = noise.fbm(uv * vec2(2.0, 16.0), octaves: 3, seed: 61);
let big = noise.fbm(uv * 2.0, octaves: 2, seed: 62);
out.color = mix(paint * 0.7, paint * 1.2, sat(g * 0.7 + big * 0.5));
out.normal = normal_from_height(g * 0.03, strength: 0.5);
out.orm = orm(occlusion: 1.0, roughness: 0.8, metallic: 0.0);
#end

#texture MonetWindowDark
tile_m = 1.0;
let n = noise.fbm(uv * 4.0, octaves: 2, seed: 71);
out.color = mix(color("#262A40"), color("#454A68"), n);
out.normal = normal_from_height(n * 0.01, strength: 0.2);
out.orm = orm(occlusion: 1.0, roughness: 0.65, metallic: 0.0);
#end

#texture MonetBark
tile_m = 1.5;
let s = noise.fbm(uv * vec2(3.0, 14.0), octaves: 4, seed: 3);
let r = noise.ridged(uv * vec2(7.0, 1.6), octaves: 3, seed: 8);
let h = sat(s * 0.5 + r * 0.6);
out.color = ramp(h, [0.0: color("#3E3450"), 0.45: color("#7A6152"), 0.8: color("#B39570"), 1.0: color("#D9C08E")]);
out.normal = normal_from_height(h * 0.09, strength: 1.3);
out.orm = orm(occlusion: 0.7 + h * 0.3, roughness: 0.92, metallic: 0.0);
#end

// Foliage colour masses for the low-poly trees (sampled by the GPU brush).
#texture MonetLeafCard
mapping = uv;
wrap = clamp;
render_mode = cutout;
size = 512;
let t = image("projimg.monet_leaf_9212e2b2", uv, wrap: "clamp");
out.color = t.rgb;
out.alpha = t.a;
out.normal = normal_from_height(dot(t.rgb, vec3(0.333, 0.333, 0.333)) * 0.03, strength: 0.3);
out.orm = orm(occlusion: 1.0, roughness: 0.85, metallic: 0.0);
#end

